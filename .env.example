# Copy to .env (git-ignored) and fill in. Never commit the real connection string.
# Atlas UI: Database > Connect > Drivers > Python. Use a database user with readWrite on the smarthr databases only.
MONGODB_URI=mongodb+srv://<user>:<password and link>
# Database name; use smarthr_demo for screenshots and demos with synthetic data.
MONGODB_DB=smarthr
# Test mode for candidate outreach: every shortlisted email and Teams invite goes to this address (your own) instead of
# the candidate's, with "[TEST for <candidate>]" in the subject. Set it while testing; never test on real resume emails.
SMARTHR_EMAIL_REDIRECT=

# SmartHR mailbox in Microsoft 365 (app-only, certificate). Setup steps: docs/SmartHR_Email_Setup.pdf. Leave empty to turn off.
SMARTHR_MAILBOX=noreply@kiaratech.ai
SMARTHR_TENANT_ID=
SMARTHR_CLIENT_ID=
SMARTHR_CERT_PATH=secrets/smarthr-key.pem
SMARTHR_CERT_THUMBPRINT=
# How often the inbox is checked for emailed resumes (minutes; 0 = only on POST /api/v1/mailbox:check).
SMARTHR_INGEST_MINUTES=2
# Interview slots: working hours and time zone of the interviewers.
SMARTHR_WORK_HOURS=09:00-18:00
SMARTHR_TIMEZONE=Asia/Kolkata
